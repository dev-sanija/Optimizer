<Window x:Class="Optimzer.DashboardWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SxS Optimizer"
        Width="1366"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        Background="#08111F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#08111F"/>
        <SolidColorBrush x:Key="ShellBrush" Color="#0B1628"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#091221"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#101B2D"/>
        <SolidColorBrush x:Key="SurfaceBrush2" Color="#0D1727"/>
        <SolidColorBrush x:Key="SurfaceBrush3" Color="#091220"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#22324A"/>
        <SolidColorBrush x:Key="StrokeBrush2" Color="#2B4161"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E7EDF7"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#93A4BB"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="#2563EB"/>
        <SolidColorBrush x:Key="ActiveNavBrush" Color="#14233B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="ChipBrush" Color="#13233A"/>
        <SolidColorBrush x:Key="RecommendedBrush" Color="#10351D"/>
        <SolidColorBrush x:Key="AdvancedBrush" Color="#382910"/>
        <SolidColorBrush x:Key="ExperimentalBrush" Color="#3A1320"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#0B1423"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#111F35"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#29415F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182844"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush2}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#122036"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182944"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#36547A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PlainInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1423"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush3}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#11233C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#173456"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatComboToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <TextBlock Text="&#xE70D;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0B1423"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Margin="12,0,8,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          RecognizesAccessKey="True"/>

                                <ToggleButton Grid.Column="1"
                                      Style="{StaticResource FlatComboToggleButtonStyle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>

                                <Popup x:Name="Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource SurfaceBrush3}"
                                    BorderBrush="{StaticResource StrokeBrush2}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                            <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#36547A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ReadOnlyOutputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush3}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Border Margin="16"
                HorizontalAlignment="Center"
                MaxWidth="1520"
                Background="{StaticResource ShellBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="22,0,0,22">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Padding="20"
                                BorderBrush="{StaticResource StrokeBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="54"
                                            Height="54"
                                            Background="#14233B"
                                            BorderBrush="#2E4769"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid>
                                            <Image x:Name="ImgSidebarLogo"
                                                   Width="34"
                                                   Height="34"
                                                   Stretch="Uniform"
                                                   Visibility="Collapsed"/>
                                            <TextBlock x:Name="TxtLogoFallback"
                                                       Text="SxS"
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SxS Optimizer"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="18"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Gaming and system control"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom"
                                Margin="18,12,18,18"
                                Style="{StaticResource CardStyle}"
                                Background="{StaticResource SurfaceBrush2}">
                            <StackPanel>
                                <TextBlock Text="Session" Style="{StaticResource ValueLabelStyle}"/>
                                <TextBlock x:Name="TxtSidebarDevice" Text="Loading device..." Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Text="Version" Style="{StaticResource ValueLabelStyle}"/>
                                <TextBlock x:Name="TxtSidebarVersion" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Text="Detected focus" Style="{StaticResource ValueLabelStyle}"/>
                                <TextBlock x:Name="TxtSidebarDetectedFocus" Text="Universal" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,18,18,18">
                                <Button x:Name="BtnNavDashboard" Tag="Dashboard" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Dashboard"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNavRunner" Tag="Runner" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Script Runner"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNavTweaks" Tag="Tweaks" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Tweaks"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNavApps" Tag="Apps" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Apps"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNavLogs" Tag="Logs" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Logs"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNavSettings" Tag="Settings" Click="NavButton_Click" Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0"/>
                                        <TextBlock Text="Settings"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="20,20,20,16" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="TxtPageTitle" Text="Dashboard" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtPageSubtitle" Text="Overview and quick access." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Atlas OS Image Button -->
                                <Button x:Name="BtnOpenAtlas" 
            Click="BtnOpenAtlas_Click" 
            Cursor="Hand" 
            Margin="0,0,12,0" 
            Background="Transparent" 
            BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image Source="/Resources/Atlas OS logo.png" 
               Height="32" 
               Width="32" 
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <!-- Optional: Gives it a slight glow to match your theme -->
                                            <DropShadowEffect Color="#4ADE80" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                        </Image.Effect>
                                    </Image>
                                </Button>

                                <Border Background="#0E2D1A" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                                    <TextBlock x:Name="TxtInternetChip" Text="Internet: Online" Foreground="#4ADE80" FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="#13233A" CornerRadius="10" Padding="10,5">
                                    <TextBlock x:Name="TxtAdminChip" Text="Admin: Yes" Foreground="#93C5FD" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,0,20,20">
                        <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="370"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Primary Actions" Style="{StaticResource SectionTitleStyle}"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnRunMainScript" Click="BtnRunMainScript_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Run Optimizer"/>
                                                <Button x:Name="BtnRefreshOverview" Click="BtnRefreshOverview_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Status"/>
                                                <Button Tag="Tweaks" Click="QuickNavigate_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Tweaks"/>
                                                <Button Tag="Logs" Click="QuickNavigate_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Logs"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Emulator Quick Actions" Style="{StaticResource SectionTitleStyle}"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnHdHighPriority" Click="BtnHdHighPriority_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Boost HD-Player Priority"/>
                                                <Button x:Name="BtnApplyEmulator240" Click="BtnApplyEmulator240_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Apply 240 FPS Profile"/>
                                                <Button x:Name="BtnOpenBlueStacksConfig" Click="BtnOpenBlueStacksConfig_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open BlueStacks Config"/>
                                                <Button x:Name="BtnOpenMsiConfig" Click="BtnOpenMsiConfig_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open MSI Config"/>
                                                
                                                <Button x:Name="BtnUnlockEmulatorConfigs" Click="BtnUnlockEmulatorConfigs_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Unlock Configs"/>
                                                <Button x:Name="BtnRelockEmulatorConfigs" Click="BtnRelockEmulatorConfigs_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Set Read-Only"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="PC Quick Actions" Style="{StaticResource SectionTitleStyle}"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnTempClean" Click="BtnTempClean_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Temp Clean"/>
                                                <Button x:Name="BtnDeepTempClean" Click="BtnDeepTempClean_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Deep Temp Clean"/>
                                                <Button x:Name="BtnShaderCacheClean" Click="BtnShaderCacheClean_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Shader Cache Clean"/>
                                                <Button x:Name="BtnRamTrim" Click="BtnRamTrim_Click" Style="{StaticResource SecondaryButtonStyle}" Content="RAM Clean"/>
                                                <Button x:Name="BtnDnsFlush" Click="BtnDnsFlush_Click" Style="{StaticResource SecondaryButtonStyle}" Content="DNS Flush"/>
                                                <Button x:Name="BtnKillOverlays" Click="BtnKillOverlays_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Kill Overlays"/>
                                                <Button x:Name="BtnOpenGraphicsSettings" Click="BtnOpenGraphicsSettings_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Graphics Settings"/>
                                                <Button x:Name="BtnOpenStartupApps" Click="BtnDisableStartupApps_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Disable Startup Apps"/>
                                                <Button x:Name="BtnDisableDiffender" Click="BtnDisableDiffender_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Disable Diffender"/>
                                                <Button x:Name="BtnEnableDiffender" Click="BtnEnableDiffender_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Enable Diffender"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="System Overview" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Operating System" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtOsName" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Processor" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtCpu" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Memory" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtRam" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Architecture / Cores" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtArch" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Machine" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtMachine" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="User" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtUser" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Internet" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtInternet" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Admin" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtAdminStatus" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Optimizer Source" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtScriptStatus" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Emulator State" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtEmulatorStatus" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Windows Note" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtSupportHint" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Detected Environment" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Active Game or Platform" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtDetectedTarget" Text="Universal" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Running processes" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtRunningProcesses" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="BlueStacks Config" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtBlueStacksConfigPath" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="MSI Config" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtMsiConfigPath" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="GameLoop" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtGameLoopState" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Profile status" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtSelectedPresetStatus" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Config Read-Only" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtConfigReadOnlyState" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Live Log Preview" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBox x:Name="TxtDashboardPreviewLog" Style="{StaticResource ReadOnlyOutputStyle}" Height="220" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PageRunner" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="420"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Runner Controls" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Current Source Mode" Style="{StaticResource ValueLabelStyle}"/>
                                        <TextBlock x:Name="TxtRunnerSourceMode" Text="Optimizer Source" Style="{StaticResource ValueTextStyle}"/>
                                        <TextBlock Text="Optimizer Source Status" Style="{StaticResource ValueLabelStyle}"/>
                                        <TextBlock x:Name="TxtRunnerOptimizerStatus" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="BtnRunnerUseOptimizerSource" Click="BtnRunnerUseOptimizerSource_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Use Optimizer Source"/>
                                            <Button x:Name="BtnRunnerRefreshOptimizer" Click="BtnRunnerRefreshOptimizer_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Optimizer Source"/>
                                        </WrapPanel>
                                        <TextBlock Text="Custom Script URL" Style="{StaticResource ValueLabelStyle}"/>
                                        <TextBox x:Name="TxtRunnerCustomScriptUrl" Style="{StaticResource PlainInputStyle}" Text=""/>
                                        <WrapPanel>
                                            <Button x:Name="BtnRunnerUseCustomSource" Click="BtnRunnerUseCustomSource_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Use Custom Source"/>
                                            <Button x:Name="BtnRunnerClearCustom" Click="BtnRunnerClearCustom_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Clear Custom Source"/>
                                        </WrapPanel>
                                        <TextBlock Text="Command Preview" Style="{StaticResource ValueLabelStyle}" Margin="0,8,0,4"/>
                                        <TextBox x:Name="TxtRunnerCommand" Style="{StaticResource ReadOnlyOutputStyle}" Height="120" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="BtnRunnerRun" Click="BtnRunMainScript_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Run Selected Source"/>
                                            <Button x:Name="BtnRunnerCopy" Click="BtnCopyRunnerCommand_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Copy Command"/>
                                            <Button Tag="Logs" Click="QuickNavigate_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Logs"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Runner Output" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBox x:Name="TxtRunnerOutput" Style="{StaticResource ReadOnlyOutputStyle}" Height="520" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="PageTweaks" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Preset" Style="{StaticResource ValueLabelStyle}"/>
                                        <ComboBox x:Name="CmbTweakPreset" Style="{StaticResource PlainComboStyle}" SelectionChanged="CmbTweakPreset_SelectionChanged">
                                            <ComboBoxItem Content="Universal"/>
                                            <ComboBoxItem Content="BlueStacks"/>
                                            <ComboBoxItem Content="MSI"/>
                                            <ComboBoxItem Content="GameLoop"/>
                                            <ComboBoxItem Content="CS2"/>
                                            <ComboBoxItem Content="Valorant"/>
                                            <ComboBoxItem Content="Fortnite"/>
                                            <ComboBoxItem Content="GTA V"/>
                                            <ComboBoxItem Content="Roblox PC"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Filters" Style="{StaticResource ValueLabelStyle}"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnFilterAll" Click="FilterChip_Click" Tag="All" Style="{StaticResource FilterChipStyle}" Content="All"/>
                                            <Button x:Name="BtnFilterRecommended" Click="FilterChip_Click" Tag="Recommended" Style="{StaticResource FilterChipStyle}" Content="Recommended"/>
                                            <Button x:Name="BtnFilterAdvanced" Click="FilterChip_Click" Tag="Advanced" Style="{StaticResource FilterChipStyle}" Content="Advanced"/>
                                            <Button x:Name="BtnFilterExperimental" Click="FilterChip_Click" Tag="Experimental" Style="{StaticResource FilterChipStyle}" Content="Experimental"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="340"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,14">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="TweakCardHost"/>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Detected / Notice" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="Preset focus" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtTweakPresetFocus" Text="Universal" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Detected game / platform" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtTweakDetectedTarget" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Running now" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtTweakRunningNow" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Recommended profile" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtTweakRecommendedProfile" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                            <TextBlock Text="Notice" Style="{StaticResource ValueLabelStyle}"/>
                                            <TextBlock x:Name="TxtTweakNotice" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Tweak Action Log" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBox x:Name="TxtTweakActionLog" Style="{StaticResource ReadOnlyOutputStyle}" Height="250" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="210"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                        <TextBlock x:Name="TxtProfilePresetTitle" Text="Selected Profile" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="TxtProfilePresetDescription" Text="Choose a preset to see its live profile controls and quick apply options." Style="{StaticResource ValueTextStyle}"/>
                                        <TextBlock Text="Target or note" Style="{StaticResource ValueLabelStyle}"/>
                                        <TextBox x:Name="TxtProfileTarget" Style="{StaticResource PlainInputStyle}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                        <TextBlock Text="FPS profile" Style="{StaticResource ValueLabelStyle}"/>
                                        <ComboBox x:Name="CmbProfileFps" Style="{StaticResource PlainComboStyle}">
                                            <ComboBoxItem Content="90"/>
                                            <ComboBoxItem Content="120"/>
                                            <ComboBoxItem Content="144"/>
                                            <ComboBoxItem Content="240"/>
                                        </ComboBox>
                                        <CheckBox x:Name="ChkProfileHighPriority" Style="{StaticResource PlainCheckStyle}" Content="Boost priority"/>
                                        <CheckBox x:Name="ChkProfileRoot" Style="{StaticResource PlainCheckStyle}" Content="Enable root access"/>
                                        <CheckBox x:Name="ChkProfileReadOnly" Style="{StaticResource PlainCheckStyle}" Content="Set config read-only after write"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quick profile actions" Style="{StaticResource ValueLabelStyle}"/>
                                        <Button x:Name="BtnProfileApply" Click="BtnProfileApply_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Apply Profile"/>
                                        <Button x:Name="BtnProfileOpenPrimary" Click="BtnProfileOpenPrimary_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Primary Path"/>
                                        <Button x:Name="BtnProfileOpenSecondary" Click="BtnProfileOpenSecondary_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Open Secondary Path"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <ScrollViewer x:Name="PageApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="App Categories" Style="{StaticResource SectionTitleStyle}"/>
                                        <UniformGrid Columns="2">
                                            <CheckBox x:Name="ChkAppsBrowsers" Style="{StaticResource PlainCheckStyle}" Content="Browsers"/>
                                            <CheckBox x:Name="ChkAppsCommunication" Style="{StaticResource PlainCheckStyle}" Content="Communication"/>
                                            <CheckBox x:Name="ChkAppsDevelopment" Style="{StaticResource PlainCheckStyle}" Content="Development"/>
                                            <CheckBox x:Name="ChkAppsUtilities" Style="{StaticResource PlainCheckStyle}" Content="Utilities"/>
                                            <CheckBox x:Name="ChkAppsMedia" Style="{StaticResource PlainCheckStyle}" Content="Media"/>
                                            <CheckBox x:Name="ChkAppsGaming" Style="{StaticResource PlainCheckStyle}" Content="Gaming Support"/>
                                        </UniformGrid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="BtnQueueAppCategories" Click="BtnQueueAppCategories_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Queue Selected"/>
                                            <Button x:Name="BtnClearAppCategories" Click="BtnClearAppCategories_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Clear Selection"/>
                                            <Button x:Name="BtnRunAppsFlow" Click="BtnRunMainScript_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Run Installer Flow"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Apps Queue Summary" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock x:Name="TxtAppQueueSummary" Text="No categories selected." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Quick Bundles" Style="{StaticResource SectionTitleStyle}"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnQueueEssentialBundle" Click="BtnQueueEssentialBundle_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Essential Browsing"/>
                                            <Button x:Name="BtnQueueDeveloperBundle" Click="BtnQueueDeveloperBundle_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Developer Bundle"/>
                                            <Button x:Name="BtnQueueGamingBundle" Click="BtnQueueGamingBundle_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Gaming Support Bundle"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PageLogs" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,6,0">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,10">
                                            <Button x:Name="BtnLogsRefresh" Click="BtnRefreshOverview_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh"/>
                                            <Button x:Name="BtnLogsCopy" Click="BtnLogsCopy_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Copy"/>
                                            <Button x:Name="BtnLogsExport" Click="BtnLogsExport_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Export"/>
                                            <Button x:Name="BtnLogsClear" Click="BtnLogsClear_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Clear"/>
                                        </WrapPanel>
                                        <TextBox x:Name="TxtLogs" Style="{StaticResource ReadOnlyOutputStyle}" Height="520" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Interface" Style="{StaticResource SectionTitleStyle}"/>
                                        <CheckBox x:Name="ChkKeepBoundedWidth" Style="{StaticResource PlainCheckStyle}" Content="Keep bounded content width on wide screens" IsChecked="True"/>
                                        <CheckBox x:Name="ChkLiveDeviceRefresh" Style="{StaticResource PlainCheckStyle}" Content="Refresh device state when requested" IsChecked="True"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Source Control" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="Current Mode" Style="{StaticResource ValueLabelStyle}"/>
                                        <TextBlock x:Name="TxtSettingsSourceMode" Text="Optimizer Source" Style="{StaticResource ValueTextStyle}"/>
                                        <TextBlock Text="Optimizer Status" Style="{StaticResource ValueLabelStyle}"/>
                                        <TextBlock x:Name="TxtSettingsOptimizerStatus" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="BtnSettingsUseOptimizerSource" Click="BtnRunnerUseOptimizerSource_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Use Optimizer Source"/>
                                            <Button x:Name="BtnSettingsRefreshScriptUrl" Click="BtnRunnerRefreshOptimizer_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh Optimizer Source"/>
                                            <Button x:Name="BtnSettingsClearCustomSource" Click="BtnRunnerClearCustom_Click" Style="{StaticResource SecondaryButtonStyle}" Content="Clear Custom Source"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
